rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each person's synced app data — only they can read or write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Community feed posts — any signed-in user can read; you can only
    // create/delete your own posts; the only field anyone else can change
    // is kudosCount (so people can like posts without owning them).
    match /community_posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kudosCount']);

      // One doc per user per post = whether they've kudos'd it.
      // Lets someone toggle only their own kudos.
      match /kudos/{kudosUid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == kudosUid;
      }
    }

    // Group Challenges — private, coworker-scoped body-composition challenges.
    // The challenge doc itself (name/joinCode/owner/visibleMetrics) is readable by
    // any signed-in user so a join code can be looked up; it holds no health data.
    // Only the owner (the challenge "leader") can update it — that's what makes
    // visibleMetrics (which metric(s) the leaderboard displays) a leader-only
    // control: a non-owner member has no write path to that field at all.
    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // One member doc per person. Only that person can write their own doc, and
      // only with these exact fields — every one of them is a *delta since this
      // person's own baseline*, never a raw/current value. Raw body fat %, fat
      // mass, weight or BMI are never allowed here, by rule, not just by client
      // convention. Only someone who is already a member of this challenge can
      // read the roster, so the group dashboard stays private to people who
      // joined with the code.
      match /members/{memberUid} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/challenges/$(challengeId)/members/$(request.auth.uid));
        allow create, update: if request.auth != null && request.auth.uid == memberUid
          && request.resource.data.keys().hasOnly(['displayName','joinedAt','bodyFatPercentChange','fatMassChange','weightChange','activeDaysSinceBaseline','goalGapClosedPercent','leanMassGainedPercent','updatedAt'])
          && !('bodyFatPercent' in request.resource.data)
          && !('fatMass' in request.resource.data)
          && !('weight' in request.resource.data)
          && !('bmi' in request.resource.data)
          && !('leanMass' in request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == memberUid;
      }
    }
  }
}
